{
  "name": "@axonometra/editor",
  "description": "Axonometra: an open-source floor planner for the browser, with a 3D view, as a React component.",
  "version": "0.5.2",
  "license": "MIT AND Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qant-au/axonometra.git"
  },
  "engines": {
    "node": ">=22.12"
  },
  "module": "./dist-lib/index.mjs",
  "types": "./dist-lib/types/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-lib/types/lib/index.d.ts",
      "import": "./dist-lib/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist-lib",
    "README.md",
    "EMBEDDING.md",
    "LICENSE",
    "LICENSE-APACHE"
  ],
  "sideEffects": [
    "./dist-lib/index.mjs",
    "./src/zodConfig.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@accurona/core": "^0.3.0",
    "@accurona/elements": "^0.3.0",
    "@accurona/ui": "^0.3.0",
    "@tabler/icons-react": "^3.44.0",
    "file-saver": "^2.0.5",
    "pixi-viewport": "^6.0.3",
    "pixi.js": "^8.19.0",
    "three": "^0.186.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.14"
  },
  "peerDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.4.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:lib": "vite build -c vite.lib.config.mts && tsc -p tsconfig.build.json",
    "preview": "vite preview",
    "test": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint src e2e",
    "lint:fix": "eslint src e2e --fix",
    "format": "prettier --write \"{src,e2e}/**/*.{ts,tsx,js,jsx,json,css,html,md}\" \"*.{ts,json,html,md}\"",
    "format:check": "prettier --check \"{src,e2e}/**/*.{ts,tsx,js,jsx,json,css,html,md}\" \"*.{ts,json,html,md}\"",
    "prepare": "simple-git-hooks || true",
    "prepublishOnly": "npm run lint && npx vitest run && npm run build:lib"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "{src,e2e}/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{json,css,html,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@eslint/js": "^9.39.4",
    "@mui/material": "^9.4.0",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.0.0",
    "@types/file-saver": "^2.0.5",
    "@types/node": "^22.20.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/ui": "^5.0.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "jsdom": "^30.1.1",
    "lint-staged": "^17.6.0",
    "prettier": "^3.8.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "simple-git-hooks": "^2.11.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
